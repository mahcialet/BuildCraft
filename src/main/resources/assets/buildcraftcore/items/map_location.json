{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "buildcraftcore:map_location_type",
    "cases": [
      { "when": "spot", "model": { "type": "minecraft:model", "model": "buildcraftcore:item/map_location/spot" } },
      { "when": "area", "model": { "type": "minecraft:model", "model": "buildcraftcore:item/map_location/area" } },
      { "when": "path", "model": { "type": "minecraft:model", "model": "buildcraftcore:item/map_location/path" } },
      { "when": "path_repeating", "model": { "type": "minecraft:model", "model": "buildcraftcore:item/map_location/path_repeating" } },
      { "when": "zone", "model": { "type": "minecraft:model", "model": "buildcraftcore:item/map_location/zone" } }
    ],
    "fallback": { "type": "minecraft:model", "model": "buildcraftcore:item/map_location/clean" }
  }
}
