{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "type",
    "cases": [
      { "when": "water", "model": { "type": "minecraft:model", "model": "minecraft:block/bedrock" } },
      { "when": "oil", "model": { "type": "minecraft:model", "model": "minecraft:block/bedrock" } }
    ],
    "fallback": { "type": "minecraft:model", "model": "minecraft:block/bedrock" }
  }
}
